{
  "name": "@frankfmy/connector-contracts",
  "version": "0.1.0",
  "description": "Strict versioned connector manifests, envelopes and signature payloads for TypeScript.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run check && bun test && bun run build"
  },
  "keywords": ["typescript", "connectors", "integration", "contracts", "event-envelope", "security"],
  "author": { "name": "Artem Prianishnikov", "email": "Pryanishnikovartem@gmail.com", "url": "https://frankfmy.com" },
  "license": "Apache-2.0",
  "homepage": "https://frankfmy.com",
  "repository": { "type": "git", "url": "git+https://github.com/FrankFMY/connector-contracts.git" },
  "bugs": { "url": "https://github.com/FrankFMY/connector-contracts/issues" },
  "engines": { "node": ">=20" },
  "packageManager": "bun@1.4.0",
  "devDependencies": { "@types/bun": "1.4.0", "@types/node": "^24.0.0", "typescript": "^6.0.0" }
}
